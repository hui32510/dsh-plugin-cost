{
  "name": "dsh-cost",
  "version": "0.8.3",
  "description": "DeepSeek Harness balance + cost chip: account balance, the last turn's or the whole conversation's estimated cost, and the peak/off-peak countdown, rendered in the composer's statistic row (and on the empty new-chat screen).",
  "license": "MIT",
  "author": "hui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hui32510/dsh-cost.git"
  },
  "homepage": "https://github.com/hui32510/dsh-cost#readme",
  "bugs": {
    "url": "https://github.com/hui32510/dsh-cost/issues"
  },
  "contributors": [
    "Andre Goncalves (original dsh-balance)"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "balance",
    "cost",
    "openrouter",
    "moonshot",
    "kimi",
    "zhipu",
    "glm",
    "minimax"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "engines": {
    "node": ">=22.18.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "immediately": false
    }
  },
  "scripts": {
    "test": "node test-harness/test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-launch-environment": "*",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-launch-environment": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
